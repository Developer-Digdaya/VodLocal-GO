[Unit]
Description=VodLocal Bus Media Server
Documentation=file:///var/www/VodLocal/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vodlocal
Group=vodlocal
WorkingDirectory=/var/www/VodLocal
EnvironmentFile=-/var/www/VodLocal/vodlocal.env
ExecStart=/var/www/VodLocal/bin/vodlocal
Restart=on-failure
RestartSec=2s
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/VodLocal/data
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
