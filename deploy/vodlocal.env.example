# Konfigurasi server — salin ke /var/www/vodlocal/vodlocal.env
# Semua nilai opsional; default ada di internal/config.

# Produksi memakai port 80. systemd unit memberi CAP_NET_BIND_SERVICE
# sehingga service tetap berjalan sebagai user non-root.
VODLOCAL_HTTP_ADDR=:80
VODLOCAL_DB_PATH=/var/www/vodlocal/data/app.db
VODLOCAL_MEDIA_ROOT=/var/www/vodlocal/data/media
VODLOCAL_LOG_LEVEL=info

VODLOCAL_SYNC_MAX_PARALLEL=8
VODLOCAL_SYNC_RETRIES=3
VODLOCAL_SYNC_RETRY_BACKOFF=2s

VODLOCAL_STORAGE_WARN_PERCENT=80
VODLOCAL_STORAGE_BLOCK_SYNC_PERCENT=90

# WAJIB diganti di produksi (minimal 16 karakter).
VODLOCAL_SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-16-karakter

# Akun admin awal. Hanya dipakai saat tabel auth_users masih kosong.
# Kosongkan keduanya bila tidak ingin membuat admin otomatis.
VODLOCAL_ADMIN_USER=admin
VODLOCAL_ADMIN_PASSWORD=ganti-password-minimal-8

# Notifikasi hasil sync (opsional). Kosongkan bila tidak dipakai.
VODLOCAL_NOTIFY_WEBHOOK_URL=
VODLOCAL_TELEGRAM_TOKEN=
VODLOCAL_TELEGRAM_CHAT_ID=

# Provider Dramahits (tab Short).
VODLOCAL_DRAMAHITS_BASE_URL=https://microdrama.digdaya.co.id/api/v1

# Provider Densgo (tab Movie & Series). Default yang sama juga ada di internal/config,
# jadi baris ini boleh dikosongkan bila ingin memakai default aplikasi.
VODLOCAL_DENSGO_BASE_URL=https://pp.dens.tv:777/index.php/v3070/adps_list_movies_v1

# Batasi episode per series saat pengujian. 0 = tanpa batas.
VODLOCAL_INGEST_MAX_EPISODES=0

VODLOCAL_READ_HEADER_TIMEOUT=10s
VODLOCAL_IDLE_TIMEOUT=120s
VODLOCAL_SHUTDOWN_TIMEOUT=15s
